# Wakeel portal — service configuration (copy to your process env / systemd unit)

# --- Service account (server-side Dify console session) ---
WAKEEL_SVC_EMAIL=you@example.gov.ae
WAKEEL_SVC_PW=your-dify-console-password

# --- Automation engine (bundled, branded as "Wakeel Automations") ---
N8N_EMAIL=admin@wakeel.local
N8N_PW=change-me

# --- AI data residency: Azure OpenAI (UAE North) ---
# When all four are set, EVERY LLM call routes to the in-country Azure
# endpoint instead of api.openai.com — no prompt/output leaves the UAE.
# Leave unset to use the global OpenAI API (read from docker/.env).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_REGION=UAE North

# --- Optional ---
# PORT=8800
# DIFY_BASE=http://localhost/console/api
