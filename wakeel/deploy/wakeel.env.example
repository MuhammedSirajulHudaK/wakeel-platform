# Copy to wakeel.env and fill in. Loaded by the wakeel.service systemd unit.

# Where Wakeel finds the Dify + n8n engines (served by nginx on the same host).
PORT=8800
DIFY_BASE=http://localhost/console/api
N8N_BASE_URL=http://localhost/automations

# --- LLM: use Azure OpenAI (UAE North) for residency, OR leave blank to fall
#     back to the OPENAI_API_KEY in docker/.env ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_REGION=UAE North

# --- Admin sign-in (magic accounts): email:password pairs, comma-separated ---
MAGIC_ACCOUNTS=admin@wakeel.ae:change-this-strong-password

# Optional single service account
WAKEEL_SVC_EMAIL=
WAKEEL_SVC_PW=
