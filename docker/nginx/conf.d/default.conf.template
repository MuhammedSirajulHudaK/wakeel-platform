# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    location /console/api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /api {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /socket.io/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /openapi {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /files {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass http://plugin_daemon:5002;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    # ---- Wakeel platform (single URL: everything under this host) ----
    location = / {
      return 302 /wakeel/;
    }
    location = /wakeel {
      return 302 /wakeel/;
    }
    location /wakeel/ {
      proxy_pass http://host.docker.internal:8800/;
      include proxy.conf;
    }


    # ---- Wakeel branding overrides (served straight from mounted assets) ----
    location = /innogent.js {
      default_type application/javascript;
      alias /innogent/innogent-inject.js;
    }
    location = /innogent-assistant.js {
      default_type application/javascript;
      alias /innogent/studio-assistant.js;
    }
    location = /logo/logo.svg {
      default_type image/svg+xml;
      alias /innogent/innogent-logo.svg;
    }
    location = /logo/logo-monochrome-white.svg {
      default_type image/svg+xml;
      alias /innogent/innogent-logo-white.svg;
    }
    location = /favicon.ico {
      default_type image/svg+xml;
      alias /innogent/innogent-favicon.svg;
    }

    # ---- Wakeel Automations (n8n) served SAME-ORIGIN so it embeds inside Wakeel ----
    # n8n emits /automations/* URLs (N8N_PATH) but serves at root, so strip the prefix.
    location = /automations { return 302 /automations/; }
    location /automations/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $n8n_upstream n8n:5678;
      rewrite ^/automations/(.*)$ /$1 break;
      proxy_pass http://$n8n_upstream;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header Content-Security-Policy;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
      proxy_buffering off;
    }

    location / {
      proxy_pass http://web:3000;
      proxy_set_header Accept-Encoding "";
      # allow the Studio to be embedded inside the Wakeel Edit tab (same host)
      proxy_hide_header X-Frame-Options;
      sub_filter_once on;
      sub_filter_types text/html;
      sub_filter '</head>' '<script src="/innogent.js?v=2" defer></script></head>';
      include proxy.conf;
    }

    location /mcp {
      proxy_pass http://api:5001;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass http://api:5001;
      include proxy.conf;
    }
    
    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}

# Wakeel connector engine — n8n on a dedicated port, embeddable (frame headers stripped).
server {
    listen 5679;
    server_name _;
    location / {
      proxy_pass http://n8n:5678;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header Content-Security-Policy;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
}

# Wakeel Community — proxy champions.innoventures.ae on a dedicated port so it can
# be embedded (the origin sends frame-ancestors 'none'; we strip it here).
server {
    listen 8081;
    server_name _;

    location / {
      proxy_pass https://champions.innoventures.ae;
      proxy_set_header Host champions.innoventures.ae;
      proxy_ssl_server_name on;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header Content-Security-Policy;
      proxy_set_header Accept-Encoding "";
    }
}
